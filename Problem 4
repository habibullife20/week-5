#include <iostream>
using namespace std;

int main() {
    int numBottles, numExchange;
    cin >> numBottles >> numExchange;

    int total_drunk = numBottles;
    int empty_bottles = numBottles;

    while (empty_bottles >= numExchange) {
        int new_bottles = empty_bottles / numExchange;
        int remaining_empties = empty_bottles % numExchange;

        total_drunk = total_drunk + new_bottles;
        empty_bottles = new_bottles + remaining_empties;
    }

    cout << total_drunk;

    return 0;
}
