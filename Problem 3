#include <iostream>

using namespace std;

int main() {
    int n;
    cin >> n;

    int i = 0;
    int current_run = 0;
    int max_run = 0;

    while (i < n) {
        int num;
        cin >> num;

        i++;

        if (num == 0) {
            current_run = 0;
            continue;
        }

        current_run++;

        if (current_run > max_run) {
            max_run = current_run;
        }
    }

    cout << max_run;

    return 0;
}
